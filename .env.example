# Quiren site. Copy to .env.local (never commit it).
NEXT_PUBLIC_SITE_URL=https://quirenrh.com
# Optional: link to the X account in the footer
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_X_HANDLE=

# Live mode on /try (optional, costs money). No key = Live is off and visitors get the recorded example.
ANTHROPIC_API_KEY=
QUIREN_SIM_MODEL=claude-opus-5-5
QUIREN_SIM_DAILY_TOKENS=2000000
# per visitor per day (a full run is about 50k)
QUIREN_SIM_VISITOR_TOKENS=150000
QUIREN_SIM_MAX_TOKENS=2048
QUIREN_SIM_RPM=60
